# name: test/sql/metadata/duckdb_merge_rewrite_stats.test
# description: Merge and rewrite in one transaction count each source row once
# group: [metadata]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/duckdb_merge_rewrite_stats.db' AS lake (DATA_PATH '{TEST_DIR}/duckdb_merge_rewrite_stats', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t (i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1)

statement ok
INSERT INTO lake.t VALUES (2)

statement ok
INSERT INTO lake.t VALUES (3), (4)

statement ok
DELETE FROM lake.t WHERE i = 4

statement ok
BEGIN

statement ok
CALL ducklake_merge_adjacent_files('lake', 't')

statement ok
CALL ducklake_rewrite_data_files('lake', 't', delete_threshold => 0)

statement ok
COMMIT

query II
SELECT record_count, (SELECT estimated_size FROM duckdb_tables() WHERE database_name = 'lake' AND table_name = 't')
FROM __ducklake_metadata_lake.ducklake_table_stats
----
3	3

query III
SELECT count(*), min(i), max(i) FROM lake.t
----
3	1	3

query II
SELECT min_value::INTEGER, max_value::INTEGER FROM __ducklake_metadata_lake.ducklake_table_column_stats
----
1	3
